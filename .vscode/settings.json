{
  // Hide only caches/logs/result blobs from the file tree.
  // Paper/COMPSAC folders are NOT touched by VS Code -- gitignore alone
  // handles tracking; the IDE shows them normally.
  "files.exclude": {
    "**/__pycache__": true,
    ".comphy_copy.log": true,
    ".comphy_move.log": true,
    "comphy_benchmark/results": true,
    "clevrer_benchmark/results": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "comphy_benchmark/results": true,
    "clevrer_benchmark/results": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "comphy_benchmark/results/**": true,
    "clevrer_benchmark/results/**": true
  }
}
